    <!-- Welcome Guide -->
    <string name="welcome_title_1">Welcome to DSH-Folk</string>
    <string name="welcome_desc_1">Run DeepSeek Harness on your phone. DSH-Folk downloads a Linux runtime, starts it in a container, and opens its Web UI locally.</string>
    <string name="welcome_title_2">Full Customization</string>
    <string name="welcome_desc_2">Customize everything — colors, backgrounds, fonts, sounds, and even haptic feedback. Existing FolkPatch / APatch theme.json files still work.</string>
    <string name="welcome_title_3">Runtime and Permissions</string>
    <string name="welcome_desc_3">Pick proot or proroot as the container backend on the home screen. DSH-Folk never patches your kernel: it detects and reuses existing root, Shizuku, or wireless ADB.</string>
    <string name="welcome_title_4">Ready to Go</string>
    <string name="welcome_desc_4">Tap start on the home screen and DSH-Folk fetches the runtime, launches dsh web, and hands you the URL. Happy hacking!</string>

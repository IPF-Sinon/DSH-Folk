    <!-- Welcome Guide -->
    <string name="welcome_title_1">FolkPatch에 오신 것을 환영합니다</string>
    <string name="welcome_desc_1">KernelPatch 기반의 높은 사용자 정의와 휴대성을 갖춘 Root 관리자입니다. 당신의 기기를 진정한 당신의 것으로 만드세요.</string>
    <string name="welcome_title_2">자유로운 커스터마이징</string>
    <string name="welcome_desc_2">색상, 배경, 글꼴, 사운드, 진동까지 모든 것을 자유롭게 설정하세요. 테마 스토어에서 더 많은 스타일을 찾아보세요!</string>
